# =============================================================================
# Real Estate Due Diligence Agent — Local Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to a file named ".env" (project root) — already in .gitignore
#   2. Fill in your actual values below
#   3. NEVER commit your real .env file
#
#   On Windows PowerShell, set env vars before running the backend:
#     $env:GOOGLE_CLIENT_ID = "your-actual-id"
#     $env:GOOGLE_CLIENT_SECRET = "your-actual-secret"
#     $env:DB_PASSWORD = "your-db-password"
#     $env:JWT_SECRET_KEY = "your-jwt-secret"
#     cd backend; .\mvnw.cmd spring-boot:run
#
# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
POSTGRES_DB=real_estate_due_diligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password-here
DB_URL=jdbc:postgresql://localhost:5432/real_estate_due_diligence

# =============================================================================
# Spring Boot Backend Server
# =============================================================================
SERVER_PORT=8081

# =============================================================================
# Security & JWT Configuration
# =============================================================================
# Generate a strong secret (PowerShell):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET_KEY=your-base64-jwt-secret-here
JWT_EXPIRATION=86400000

# =============================================================================
# Google OAuth2 Configuration
# =============================================================================
# 1. Go to https://console.cloud.google.com/
# 2. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client IDs
# 3. Application type = "Web application"
# 4. Add Authorized redirect URI: http://localhost:8081/login/oauth2/code/google
# 5. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# =============================================================================
# Microsoft OAuth2 Configuration (optional)
# =============================================================================
# 1. Go to https://portal.azure.com/ → Azure AD → App registrations
# 2. Add redirect URI: http://localhost:8081/login/oauth2/code/microsoft
MICROSOFT_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-oauth-client-secret

# =============================================================================
# Frontend Configuration
# =============================================================================
VITE_API_BASE_URL=http://localhost:8081
FRONTEND_REDIRECT_URI=http://localhost:5174/oauth2/redirect
FRONTEND_LOGIN_URI=http://localhost:5174/login
FRONTEND_COMPLETE_OAUTH_REGISTRATION_URI=http://localhost:5174/complete-oauth-registration
